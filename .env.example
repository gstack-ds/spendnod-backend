# ============================================================
# SpendNod — required environment variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- Database ---
# Use the Supabase Session Pooler URL (NOT the direct or transaction pooler).
# Format: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Railway containers are IPv4-only; the direct connection is IPv6-only and will fail.
DATABASE_URL=postgresql+asyncpg://postgres.yourref:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Supabase ---
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- JWT ---
# MUST match the JWT secret in Supabase → Project Settings → API → JWT Secret.
# Never rotate this independently — it will invalidate all active user sessions.
JWT_SECRET=your-supabase-jwt-secret

# --- Email notifications (optional) ---
# Resend API key for sending pending-approval emails (https://resend.com).
# Leave blank to disable email notifications.
RESEND_API_KEY=

# --- URLs ---
# Public URL of this API — used by MCP tools to call back into the API.
API_URL=https://your-api-url.com

# Dashboard URL — included in notification emails as the approve/deny link.
DASHBOARD_URL=https://your-dashboard-url.com

# --- CORS (optional) ---
# Comma-separated list of additional allowed origins beyond localhost:3000.
# Example: https://app.yourdomain.com,https://staging.yourdomain.com
CORS_ORIGINS=

# --- Environment ---
ENVIRONMENT=development
